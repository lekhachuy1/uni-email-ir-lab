# Sao chép thành .env rồi đặt mật khẩu MẠNH của riêng bạn. KHÔNG commit .env.
# Keycloak admin (tạo ở lần khởi động đầu)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=ChangeMe_Admin_123456
# PostgreSQL cho Keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=ChangeMe_DB_123456
# Mật khẩu dùng chung cho 11 tài khoản người dùng (Keycloak = mail, cho lab)
USER_PW=ChangeMe_User_123456
MAIL_PW=ChangeMe_User_123456
# Áp cấu hình v1 (1) hay giữ v0 (0) khi tạo realm
APPLY_V1=1
